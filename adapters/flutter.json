{
  "schema": "btk-platform-adapters/1",
  "shared": {
    "flutter_semantics": true,
    "provenance": {
      "path": "assets/assets/diagnostics/build_metadata.json",
      "field": [
        "repository",
        "revision",
        "sha"
      ]
    },
    "elements": [
      "[flt-semantics-identifier=\"shared-header-title\"]",
      "[flt-semantics-identifier=\"shared-header-home\"]",
      "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
      "[flt-semantics-identifier=\"shared-header-menu\"]"
    ],
    "click": {
      "target": "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
      "observe": "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
      "attribute": "textContent",
      "before": "Favorite this page",
      "after": "Remove favorite"
    }
  },
  "adapters": {
    "flutter-clipboard-shelf": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/core/clipboard-shelf"
    },
    "flutter-counter": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/examples/counter-playground",
      "elements": [
        "[flt-semantics-identifier=\"shared-header-title\"]",
        "[flt-semantics-identifier=\"shared-header-home\"]",
        "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
        "[flt-semantics-identifier=\"shared-header-menu\"]",
        "[data-btk-probe=\"increase\"]",
        "[data-btk-probe=\"decrease\"]"
      ],
      "click": {
        "target": "[data-btk-probe=\"increase\"]",
        "observe": "[data-btk-probe=\"reset\"]",
        "attribute": "aria-disabled",
        "before": "true",
        "after": null
      },
      "bindings": {
        "increase": {
          "selector": "flt-semantics[role=\"button\"]",
          "text": "Increase"
        },
        "decrease": {
          "selector": "flt-semantics[role=\"button\"]",
          "text": "Decrease"
        },
        "reset": {
          "selector": "flt-semantics[role=\"button\"]",
          "text": "Reset"
        }
      }
    },
    "flutter-home": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/"
    },
    "flutter-http-request-draft": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/tools/http/request-draft"
    },
    "flutter-hub": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/hub"
    },
    "flutter-now-timeline": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/tools/time/now-timeline"
    },
    "flutter-photo-studio": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/tools/media/photo-studio"
    },
    "flutter-screen1": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/screen1"
    },
    "flutter-ui-showcase": {
      "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/examples/ui-showcase"
    }
  }
}
